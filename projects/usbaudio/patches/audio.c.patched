/* Includes ------------------------------------------------------------------ */
#include "main.h"
#include "usbh_audio.h"
#include "ff.h"
#include "ff_gen_drv.h"
#include "audio.h"
#include <string.h>

/* 目標音量：裝置自己回報的 volumeMin..volumeMax 之間取百分之幾。
 *
 * **不是「按幾下 VOLUME_UP」**。ST 的類別只給相對的 UP/DOWN，按幾下的
 * 結果完全取決於裝置的預設值與 resolution，換一支耳機就不一樣。
 * 這裡改成算出絕對目標再自己走過去，並且把裝置回報的刻度印出來，
 * 之後要調就是改這個數字。
 *
 * UAC1 的音量是有號 16 bit、單位 1/256 dB（0x8000 是靜音，不是最小聲）。
 * ST 把它存進 uint32_t，所以要自己轉回 int16_t 才有意義。 */
/* 57% -> -32dB。這是使用者實際戴著 JBL 聽過、說「音量還OK」的位置
 * （2026-08-26）。**不是算出來的，是聽出來的** —— dB 是對數刻度，
 * 百分比只是給人調的把手，不要用它去推「應該多大聲」。
 *
 * 接進相簿之後音量會是螢幕上的控制項，這個常數只管治具的起始值。 */
/* 起始音量。按 USER 鍵可以往下調，調到滿意的 dB 之後把百分比寫回這裡。 */
#define AUDIO_VOL_PERCENT   50U
#define AUDIO_VOL_STEP_PCT  8U     /* 按一下降幾個百分點（8% x 74dB = 約 6dB）*/
#define AUDIO_VOL_FLOOR_PCT 13U    /* 降到這裡以下就繞回 AUDIO_VOL_PERCENT */
/* **時限，不是步數上限。** 原本用步數，結果迴圈根本不收斂：類別每設一次
 * 音量就回頭去讀裝置回報的值（cs_req_state = AUDIO_REQ_GET_VOLUME），
 * 那個值不會停在我算的目標上，所以「到位」永遠不成立 ——
 * 於是每 120ms 發一筆控制傳輸，**整場不停**。
 * 一步音量是分兩筆設左右聲道的，持續不斷地發就會聽到左右切換。
 * 給它 12 秒把音量帶到大概的位置，時間到就閉嘴。 */
#define AUDIO_VOL_BUDGET_MS 12000U
#include "explorer.h"

/* functions prototypes ---------------------------------------------*/
void Error_Handler(void);

/* Private define ------------------------------------------------------------ */
/* --- 暫時的測試修改：把緩衝放大、讀取變大塊 ---------------------
 * 原本是 512 x 33 = 16,896 bytes = **88 毫秒**，而且每次只從卡上讀
 * 512 個位元組（2.7ms 的音訊）。在 512GB 的 exFAT 卡上，每筆 512 bytes
 * 都是一次完整的磁區存取 —— 要補滿半個緩衝要連續 16 次小讀取，
 * 中間還夾著 USB 的處理，跟不上就是緩衝掏空、波形不連續。
 *
 * 對照我們自己的 I2S 路徑：緩衝 170ms、一次讀 16KB（實測 5.4ms），
 * 9.5 分鐘零欠載。這裡照那個量級調。 */
#define AUDIO_BLOCK_SIZE        512
#define AUDIO_BLOCK_NBR         33
#define FILEMGR_LIST_DEPDTH     24
#define FILEMGR_FILE_NAME_SIZE  40
#define FILEMGR_MAX_LEVEL       4
#define FILETYPE_DIR            0
#define FILETYPE_FILE           1
/* Private typedef ----------------------------------------------------------- */
typedef struct AUDIO_Info_t {
  uint32_t ChunkID;       /* 0  */
  uint32_t FileSize;      /* 4  */
  uint32_t FileFormat;    /* 8  */
  uint32_t SubChunk1ID;   /* 12 */
  uint32_t SubChunk1Size; /* 16 */
  uint16_t AudioFormat;   /* 20 */
  uint16_t NbrChannels;   /* 22 */
  uint32_t SampleRate;    /* 24 */
  uint32_t ByteRate;      /* 28 */
  uint16_t BlockAlign;    /* 32 */
  uint16_t BitPerSample;  /* 34 */
  uint32_t SubChunk2ID;   /* 36 */
  uint32_t SubChunk2Size; /* 40 */
}WAV_InfoTypedef;

typedef struct _FILELIST_LineTypeDef {
  uint8_t type;
  uint8_t name[FILEMGR_FILE_NAME_SIZE];
}FILELIST_LineTypeDef;

typedef struct _FILELIST_FileTypeDef {
  FILELIST_LineTypeDef  file[FILEMGR_LIST_DEPDTH] ;
  uint16_t              ptr;
} FILELIST_FileTypeDef;

typedef enum {
  APPLICATION_IDLE = 0,
  APPLICATION_START,
  APPLICATION_READY,
  APPLICATION_DISCONNECT,
} AUDIO_ApplicationTypeDef;

typedef struct
{
  uint8_t buff[AUDIO_BLOCK_SIZE * AUDIO_BLOCK_NBR];
  int32_t out_ptr;
  uint32_t in_ptr;
} Audio_BufferTypeDef;

/* Private variables --------------------------------------------------------- */
AUDIO_PLAYBACK_StateTypeDef AUDIO_app_state;
AUDIO_PLAYBACK_StateTypeDef AUDIO_app_prev_state;
static WAV_InfoTypedef WavInfo;
static FIL WavFile;
static Audio_BufferTypeDef BufferCtl;
int16_t FilePos = 0;

/* --- 開播的三個階段，每一個都有自己的旗標 -------------------------------
 * 原本的程式**沒有這三個旗標**，全部擠在 USBH_AUDIO_GetOutOffset() 回的
 * -1 裡面 —— 而那個 -1 同時代表「還沒開播」與「檔案播完了」。
 * 分不開的後果見 README〈爆音的模型錯在哪〉。 */
static uint8_t mic_off      = 1U;       /* 0=還沒把麥克風放回 alt 0 */
static uint8_t force_alt    = 1U;       /* 0=還沒送那筆強制 SET_INTERFACE */
static uint8_t pre_alt      = 1U;       /* 0=還沒讀開播前的 alt */
static uint8_t mute_step    = 3U;       /* 0=讀 1=寫 2=再讀 3=做完了 */
static uint8_t rb_step      = 3U;       /* 對帳：0=alt 1=取樣率 2=音量 3=做完 */
static uint8_t dvol_step    = 2U;       /* 直接設音量：0=ch1 1=ch2 2=做完 */
/* 先開到最大來回答「音量寫得進去嗎」。ROG 的 Feature Unit 是
 * bmaControls[0]=0x01（主聲道只有靜音）、[1]=[2]=0x02（音量在聲道 1、2），
 * 所以寫要寫聲道 1 和 2，**讀也要讀聲道 1** —— 我前一輪讀聲道 0，
 * 那是一個不存在的控制，讀回 -74dB 根本不能當證據。 */
#define AUDIO_VOL_DB   (-32)   /* 使用者實聽認可的位置 */

/* 把 ST 類別的相對音量爬升整個關掉。
 * 它是開播之後唯一大量的主機->裝置流量（12 秒、72 筆控制傳輸），
 * 而對帳量到裝置在那之後從 alt=1 掉回 alt=2。先拿掉這個變因。
 * 音量改用我們自己那一次絕對值 SET_CUR（AUDIO_VOL_DB）。 */
#define AUDIO_USE_CLASS_VOL  0
static uint8_t freq_pending = 0U;       /* 取樣率還沒設定成功 */
static uint8_t play_pending = 0U;       /* 取樣率設好了，Play 還沒回 OK */
static uint8_t play_started = 0U;       /* Play 回過 USBH_OK，資料真的在送 */
static volatile uint8_t eof_seen = 0U;  /* 類別回報整段送完（唯一可信的「播完了」）*/
static uint32_t dbg_unexpected = 0U;    /* 開播之後非預期停下來的次數 */

/* 目前的目標音量百分比。USER 鍵會改它，所以是 volatile。 */
static volatile uint8_t g_vol_pct   = AUDIO_VOL_PERCENT;
static volatile uint8_t g_vol_dirty = 0U;   /* 目標變了，要重新走過去 */

/* --- 量測：爆音的兩個候選機制，分得開 -----------------------------------
 * 波形不連續只有兩種來源，而它們要換的東西完全不同：
 *
 * (A) **掏空**：應用層來不及補，類別把還沒換掉的舊資料再送一次。
 *     看得到的量：**可播存量（runway）**＝已經寫好、還沒被送出去的位元組。
 *     逼近 0 就是掏空。
 *
 * (B) **衝出緩衝結尾**：usbh_audio.c 的 AUDIO_DATA_OUT **完全沒有對 cbuf
 *     做邊界檢查** —— 送完整個緩衝之後 cbuf 繼續往前走，要靠應用層在主
 *     迴圈裡看到 out_ptr 到底了才呼叫 ChangeOutBuffer 把它拉回來。
 *     512x33 = 16896 剛好是 88 個封包，所以每 88ms 就有一次機會；
 *     那一刻主迴圈要是慢了（f_read 正好卡住），送出去的就是緩衝後面的
 *     記憶體。**「每 88ms 一次的機會」跟「週期性爆音」形狀吻合。**
 *     看得到的量：out_ptr 有沒有大於緩衝總長。這是是非題，不必量時間。
 *
 * 兩個都不必動任何緩衝參數 —— 上一輪掃參數掃錯了東西，這次先把尺架好。
 * 數字每秒印一次、印完歸零，所以每一行講的是那一秒發生的事，
 * 可以跟耳朵聽到爆音的時間點對起來。
 *
 * 哨兵值 0xFFFFFFFF：分辨「這一秒沒跑到」與「跑了但結果是 0」。
 * HAL_GetTick 的解析度是 1ms，只夠抓「迴圈卡了好幾毫秒」這種量級；
 * 要是 gap_max 印出來都是 1，代表這把尺不夠細，得換 DWT。 */
#define AUDIO_BUF_TOTAL   (AUDIO_BLOCK_SIZE * AUDIO_BLOCK_NBR)
static uint32_t dbg_runway_min = 0xFFFFFFFFU;  /* (A) 最小可播存量，位元組 */
static uint32_t dbg_over_cnt   = 0U;           /* (B) out_ptr 超出結尾的次數 */
static uint32_t dbg_over_max   = 0U;           /* (B) 最多超出去幾個位元組 */
static uint32_t dbg_gap_max    = 0U;           /* 兩次 PLAY 迴圈最大間隔 ms */
static uint32_t dbg_gap_prev   = 0xFFFFFFFFU;
static uint32_t dbg_read_cnt   = 0U;           /* f_read 次數 */
static uint32_t dbg_read_max   = 0U;           /* 最慢一次 f_read 幾 ms */

/* --- 第三個候選，也是前兩個量不到的那個 ---------------------------------
 * (C) **訊框根本沒送出去。** usbh_audio.c 的 AUDIO_DATA_OUT 是從**主迴圈**
 *     跑的（USBH_Process），不是從 SOF 中斷。它的條件是「上一筆 URB 完成
 *     且距離上次送出 >= Poll(1ms)」—— 主迴圈卡住幾毫秒，那幾個 1ms 的訊框
 *     就完全沒有封包送出去。裝置那端沒收到資料就是波形斷掉。
 *
 *     **這種斷法不會消耗緩衝**，所以 (A) 的 runway 永遠看起來健康 ——
 *     前一把尺量不到它，不是因為沒發生，是因為量錯地方。
 *
 * 量法：等時端點是 1 封包 / 1 毫秒，所以「這一秒真的送出去幾個封包」
 * 應該正好等於「這一秒經過幾毫秒」。少掉的就是斷掉的訊框數。
 * 這是整數對整數，沒有解析度問題。
 *
 * **收集期間完全不印東西**，整張表最後一次倒出來 —— 上一版的診斷行
 * 85 個字元 @115200 就要 7.4ms，量到的 gap_max=7ms 有一大半是尺自己
 * 造成的。尺不能比受測物還粗，更不能自己就是干擾源。 */
#define DBG_SAMPLES  45U
static uint32_t dbg_pk[DBG_SAMPLES];   /* 那一格真的送出去幾個封包 */
static uint32_t dbg_ms[DBG_SAMPLES];   /* 那一格實際經過幾毫秒 */
static uint32_t dbg_gp[DBG_SAMPLES];   /* 那一格的迴圈最大間隔 */
static uint32_t dbg_rw[DBG_SAMPLES];   /* 那一格的最小可播存量 */
/* 主迴圈跑了幾圈。USBH_AUDIO_OutputStream 一次呼叫最多送一個封包，
 * 而它是從主迴圈跑的 —— 所以送出速率的上限就是這個數字。
 * 要是 it 也是 960 左右，「pk=960」就不必再找別的解釋了。 */
static uint32_t dbg_it[DBG_SAMPLES];
static uint32_t dbg_it_cnt = 0U;
static uint32_t dbg_rd[DBG_SAMPLES];   /* 那一格 f_read 幾次 */
/* 那一格數到幾個 SOF。hUsbHostFS.Timer 就是 SOF 計數（HAL_HCD_SOF_Callback
 * -> USBH_LL_IncTimer）。全速匯流排的 SOF 應該是 1000/秒。
 * **這個數字分掉兩種完全不同的病**：
 *   sof≈960 -> USB 時脈本身慢 4%，整條鏈一起慢，波形其實是連續的
 *   sof≈1000 而 pk=960 -> 真的每秒漏掉 40 個訊框 */
static uint32_t dbg_sf[DBG_SAMPLES];
static uint32_t dbg_s0 = 0U;
static uint32_t dbg_t0 = 0xFFFFFFFFU;
static uint32_t dbg_g0 = 0U;
static uint16_t dbg_n  = 0U;
static uint8_t  dbg_phase = 0U;        /* 0=收集中 1=收集完待印 2=印過了 */

/* 類別送出去的總位元組數。單調遞增，不會繞回，取差值就是那一格的量。 */
static uint32_t audio_global_ptr(void)
{
  AUDIO_HandleTypeDef *h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

  return (h != NULL) ? h->headphone.global_ptr : 0xFFFFFFFFU;
}

uint8_t* oldfile;

/* Exported variables ------------------------------------------------------- */
extern AUDIO_ApplicationTypeDef Appli_state;
extern USBH_HandleTypeDef hUsbHostFS;
extern FILELIST_FileTypeDef FileList;

/* Private function prototypes ----------------------------------------------- */
static AUDIO_ErrorTypeDef AUDIO_GetFileInfo(uint16_t file_idx, WAV_InfoTypedef * info);
AUDIO_ErrorTypeDef AUDIO_Start(uint8_t idx);
AUDIO_ErrorTypeDef AUDIO_Process(void);
AUDIO_ErrorTypeDef AUDIO_Stop(void);

/* Exported function prototypes ----------------------------------------------- */
extern uint8_t Audio_ShowWavFiles(void);

/* --- 量測：把設定描述元原封不動印出來 --------------------------------
 * 要回答的問題只有一個：**等時 OUT 端點的同步型別**（端點描述元
 * bmAttributes 的 bits[3:2]）。adaptive 的話裝置跟著我們的送出速度走，
 * 剩下的只是緩衝設計；asynchronous 的話得自己實作 feedback 端點，
 * 而 usbh_audio.c 整份沒有這個東西。
 *
 * 為什麼印「整份原始位元組」而不是只印那一個欄位：
 * ST 的類別把描述元拆進 AUDIO_HandleTypeDef 時**沒有保留 bmAttributes**
 * （stream_out[] 只有 Ep / EpSize / interface / AltSettings / Poll），
 * 要看的欄位在解析之後就不見了。原始位元組是這裡最細的尺，而且同一次
 * 量測順便看得到：有沒有伴隨的 feedback 端點（bSynchAddress）、每個
 * alt setting 的封包大小與 bInterval、裝置支援哪些取樣率。
 *
 * 板子這邊多印一行解碼摘要只是交叉檢查；真正的判讀在電腦端對 hex 做。
 */
static void USB_DumpCfgDesc(void)
{
  const uint8_t *raw = hUsbHostFS.device.CfgDesc_Raw;
  /* 裝置自己回報的長度（raw 的第 2、3 個位元組）。**不能用
   * CfgDesc.wTotalLength 判斷有沒有被截斷** —— 那個值在解析時就已經被
   * MIN() 夾到 USBH_MAX_SIZE_CONFIGURATION，看起來永遠剛剛好。 */
  uint16_t dev_total = (uint16_t)raw[2] | ((uint16_t)raw[3] << 8);
  uint16_t have      = hUsbHostFS.device.CfgDesc.wTotalLength;
  uint16_t i;
  uint8_t  iso_seen = 0U;
  uint8_t  cur_if = 0xFFU, cur_alt = 0xFFU;

  USBH_UsrLog("=== CFGDESC BEGIN VID=%04X PID=%04X dev_total=%u stored=%u ===",
              (unsigned)hUsbHostFS.device.DevDesc.idVendor,
              (unsigned)hUsbHostFS.device.DevDesc.idProduct,
              (unsigned)dev_total, (unsigned)have);

  if (dev_total > have)
  {
    USBH_UsrLog("!! TRUNCATED: 裝置有 %u bytes，緩衝只收得下 %u",
                (unsigned)dev_total, (unsigned)have);
  }

  for (i = 0U; i < have; i += 16U)
  {
    char     line[16 * 3 + 1];
    uint16_t j, n = 0U;

    for (j = 0U; (j < 16U) && ((i + j) < have); j++)
    {
      n += (uint16_t)sprintf(&line[n], "%02X ", raw[i + j]);
    }
    line[n] = '\0';
    USBH_UsrLog("%03X: %s", (unsigned)i, line);
  }
  USBH_UsrLog("=== CFGDESC END ===");

  /* 走一遍描述元鏈，把每一個等時端點解碼出來 */
  i = 0U;
  while ((i + 2U) <= have)
  {
    uint8_t blen = raw[i];
    uint8_t btyp = raw[i + 1U];

    if (blen < 2U)
    {
      USBH_UsrLog("!! bLength=0 於位移 %u，鏈斷了，停止走訪", (unsigned)i);
      break;
    }
    if ((uint16_t)(i + blen) > have)
    {
      USBH_UsrLog("!! 位移 %u 的描述元超出緩衝，停止走訪", (unsigned)i);
      break;
    }

    if ((btyp == 0x04U) && (blen >= 9U))            /* INTERFACE */
    {
      cur_if  = raw[i + 2U];
      cur_alt = raw[i + 3U];
    }
    else if ((btyp == 0x05U) && (blen >= 7U))       /* ENDPOINT */
    {
      uint8_t  addr  = raw[i + 2U];
      uint8_t  attr  = raw[i + 3U];
      uint16_t mps   = (uint16_t)raw[i + 4U] | ((uint16_t)raw[i + 5U] << 8);
      uint8_t  intvl = raw[i + 6U];

      if ((attr & 0x03U) == 0x01U)                  /* 等時 */
      {
        static const char * const sync_name[4] =
          { "NONE", "ASYNCHRONOUS", "ADAPTIVE", "SYNCHRONOUS" };
        static const char * const usage_name[4] =
          { "data", "feedback", "implicit-fb", "reserved" };

        iso_seen++;
        /* UAC1 的端點描述元是 9 個位元組（多了 bRefresh、bSynchAddress）。
         * 只有 7 個的話就沒有 bSynchAddress，印哨兵值 FF 而不是 0 ——
         * 0 是「沒有伴隨端點」的合法值，跟「這個欄位不存在」不一樣。 */
        USBH_UsrLog("ISO EP %02X %-3s if=%u alt=%u attr=%02X sync=%s usage=%s "
                    "mps=%u x%u bInterval=%u bLength=%u bSynchAddress=%02X",
                    (unsigned)addr, ((addr & 0x80U) != 0U) ? "IN" : "OUT",
                    (unsigned)cur_if, (unsigned)cur_alt, (unsigned)attr,
                    sync_name[(attr >> 2) & 0x03U],
                    usage_name[(attr >> 4) & 0x03U],
                    (unsigned)(mps & 0x07FFU),
                    (unsigned)(((mps >> 11) & 0x03U) + 1U),
                    (unsigned)intvl, (unsigned)blen,
                    (blen >= 9U) ? (unsigned)raw[i + 8U] : 0xFFU);
      }
    }
    i = (uint16_t)(i + blen);
  }

  if (iso_seen == 0U)
  {
    USBH_UsrLog("!! 走訪跑完了，但一個等時端點都沒有 —— "
                "這是「真的沒有」，不是「沒跑到」");
  }

  /* 類別最後挑了哪一個 alt setting —— 拿來跟上面的清單對照，
   * 才知道我們實際在用的是哪一個端點。 */
  {
    AUDIO_HandleTypeDef *h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

    if (h != NULL)
    {
      USBH_UsrLog("CLASS PICK: headphone supported=%u if=%u alt=%u Ep=%02X "
                  "EpSize=%u Poll=%u",
                  (unsigned)h->headphone.supported,
                  (unsigned)h->headphone.interface,
                  (unsigned)h->headphone.AltSettings,
                  (unsigned)h->headphone.Ep,
                  (unsigned)h->headphone.EpSize,
                  (unsigned)h->headphone.Poll);
    }
    else
    {
      USBH_UsrLog("CLASS PICK: pData 是 NULL（類別還沒配置）");
    }
  }
}


/* --- 挑「格式相符」的 alt setting ------------------------------------
 * ST 的 USBH_AUDIO_InterfaceInit 是**挑端點最大的**（原始碼註解就寫著
 * "largest endpoint size : default behavior"）。裝置只有一個 alt 時沒差
 * —— JBL Quantum TWS 就是 —— 但 ROG Delta II (2.4GHz) 有兩個：
 *
 *     if=1 alt=1   16-bit   mps 384
 *     if=1 alt=2   24-bit   mps 576   <- ST 挑這個
 *
 * 而我們的 wav 是 16-bit。裝置被切到 24-bit 之後每個訊框期待 288 bytes，
 * 我們送 192，長度不對就整包丟掉 —— **實測完全沒聲音**。
 *
 * 這裡走一遍原始描述元找相符的 alt。**不靠 class_desc.as_desc[] 的索引
 * 去對 stream_out[]** —— 那兩個陣列的順序對不對得上是沒有保證的假設，
 * 原始位元組才是唯一不會騙人的來源（跟量端點同步型別同一個理由）。
 *
 * 哨兵 0xFF = 沒找到，跟「找到 interface 0」分得開。 */
static uint8_t  g_alt_if  = 0xFFU;
static uint8_t  g_alt_num = 0xFFU;
static uint16_t g_alt_mps = 0U;

static void usb_pick_matching_alt(uint32_t rate, uint8_t ch, uint8_t bits)
{
  const uint8_t *raw = hUsbHostFS.device.CfgDesc_Raw;
  uint16_t have = hUsbHostFS.device.CfgDesc.wTotalLength;
  uint16_t i = 0U;
  uint8_t  cur_if = 0xFFU, cur_alt = 0xFFU;
  uint8_t  fmt_ok = 0U;

  g_alt_if  = 0xFFU;
  g_alt_num = 0xFFU;
  g_alt_mps = 0U;

  while ((uint16_t)(i + 2U) <= have)
  {
    uint8_t blen = raw[i];
    uint8_t btyp = raw[i + 1U];

    if ((blen < 2U) || ((uint16_t)(i + blen) > have)) { break; }

    if ((btyp == 0x04U) && (blen >= 9U))            /* INTERFACE */
    {
      cur_if  = raw[i + 2U];
      cur_alt = raw[i + 3U];
      fmt_ok  = 0U;                                 /* 換 alt 就重算 */
    }
    else if ((btyp == 0x24U) && (blen >= 8U) && (raw[i + 2U] == 0x02U))
    {
      /* CS_INTERFACE / FORMAT_TYPE：
       * [3]bFormatType [4]bNrChannels [5]bSubframeSize [6]bBitResolution
       * [7]bSamFreqType [8..]tSamFreq（每個 3 bytes，0 代表 [min,max] 範圍）*/
      if ((raw[i + 3U] == 0x01U) && (raw[i + 4U] == ch) && (raw[i + 6U] == bits))
      {
        uint8_t nfreq = raw[i + 7U];

        if (nfreq == 0U)
        {
          if (blen >= 14U)
          {
            uint32_t lo = (uint32_t)raw[i + 8U] | ((uint32_t)raw[i + 9U] << 8) |
                          ((uint32_t)raw[i + 10U] << 16);
            uint32_t hi = (uint32_t)raw[i + 11U] | ((uint32_t)raw[i + 12U] << 8) |
                          ((uint32_t)raw[i + 13U] << 16);
            if ((rate >= lo) && (rate <= hi)) { fmt_ok = 1U; }
          }
        }
        else
        {
          uint8_t k;

          for (k = 0U; k < nfreq; k++)
          {
            uint16_t o = (uint16_t)(i + 8U + ((uint16_t)k * 3U));

            if ((uint16_t)(o + 3U) > (uint16_t)(i + blen)) { break; }
            if ((((uint32_t)raw[o]) | ((uint32_t)raw[o + 1U] << 8) |
                 ((uint32_t)raw[o + 2U] << 16)) == rate)
            {
              fmt_ok = 1U;
              break;
            }
          }
        }
      }
    }
    else if ((btyp == 0x05U) && (blen >= 7U) && (fmt_ok != 0U))
    {
      uint8_t addr = raw[i + 2U];

      if (((addr & 0x80U) == 0U) && ((raw[i + 3U] & 0x03U) == 0x01U))
      {
        g_alt_if  = cur_if;                          /* OUT 等時，就是它 */
        g_alt_num = cur_alt;
        g_alt_mps = (uint16_t)(((uint16_t)raw[i + 4U] |
                                ((uint16_t)raw[i + 5U] << 8)) & 0x07FFU);
        break;
      }
    }
    else
    {
      /* 其他描述元，略過。 */
    }

    i = (uint16_t)(i + blen);
  }
}


/* --- 靜音：ST 的類別定義了 MUTE_CONTROL 卻從來沒用過 -------------------
 * `grep -n "MUTE\|mute" usbh_audio.c` 的結果是**空的** —— 整個類別不曾
 * 讀寫靜音位元。裝置要是處於靜音狀態，主機端會看到一個完美的串流
 * （0 斷線、0 缺口、時脈精準）而使用者什麼都聽不到。
 *
 * 組法照抄 USBH_AC_SetCur：
 *   wIndex = (UnitID << 8) | AC 介面號（類別寫死 0）
 *   wValue = (控制選擇碼 << 8) | 聲道號（0 = 主聲道）
 * 用 phost->Control 直接送，跟 USBH_SetInterface 同一個機制，
 * 回 USBH_BUSY 就重試。
 *
 * **先讀、再寫、再讀。** 不然「本來就沒靜音」跟「寫進去沒生效」分不開，
 * 而那兩件事接下來要查的方向完全不同。 */
static uint8_t g_mute_val = 0xFFU;      /* 哨兵：還沒讀過 */

static USBH_StatusTypeDef audio_mute_req(uint8_t is_set, uint8_t value)
{
  AUDIO_HandleTypeDef *h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;
  AUDIO_FeatureDescTypeDef *fu;

  if (h == NULL) { return USBH_FAIL; }

  fu = h->class_desc.cs_desc.FeatureUnitDesc[h->headphone.asociated_feature];
  if (fu == NULL) { return USBH_FAIL; }

  if (hUsbHostFS.RequestState == CMD_SEND)
  {
    if (is_set != 0U) { g_mute_val = value; }

    hUsbHostFS.Control.setup.b.bmRequestType =
      (uint8_t)(((is_set != 0U) ? USB_H2D : USB_D2H) |
                USB_REQ_RECIPIENT_INTERFACE | USB_REQ_TYPE_CLASS);
    hUsbHostFS.Control.setup.b.bRequest  =
      (uint8_t)((is_set != 0U) ? UAC_SET_CUR : UAC_GET_CUR);
    hUsbHostFS.Control.setup.b.wValue.w  = (uint16_t)((uint16_t)MUTE_CONTROL << 8);
    hUsbHostFS.Control.setup.b.wIndex.w  = (uint16_t)((uint16_t)fu->bUnitID << 8);
    hUsbHostFS.Control.setup.b.wLength.w = 1U;
  }

  return USBH_CtlReq(&hUsbHostFS, &g_mute_val, 1U);
}


/* --- 把「裝置自己的認知」讀回來 ---------------------------------------
 * ROG Delta II 的狀況是：alt 切對了、沒靜音、串流完美（0 斷線、
 * pk=1000/秒 代表每個 URB 都完成）、音量滾輪轉到底 —— 就是沒聲音。
 * 到這裡所有「我們以為設好了」的東西都該去跟裝置本人對一次帳。
 *
 * 三個問題，一次問完：
 *   GET_INTERFACE      -> 它**實際**在哪個 alt（不是我們以為的）
 *   GET_CUR 取樣率     -> 它以為現在是幾 Hz（端點控制，wIndex = 端點位址）
 *   GET_CUR 音量       -> 跟類別維護的 attribute.volume 對不對得上
 *
 * 組法照抄 USBH_AUDIO_SetEndpointControls 與 USBH_AC_SetCur，
 * 只是方向反過來（USB_D2H / UAC_GET_CUR）。 */
static uint8_t g_rb[4];

static USBH_StatusTypeDef audio_readback(uint8_t step)
{
  AUDIO_HandleTypeDef *h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

  if (h == NULL) { return USBH_FAIL; }

  if (hUsbHostFS.RequestState == CMD_SEND)
  {
    /* **哨兵 0xAA，不是 0。** alt 0 是合法答案（零頻寬設定），
     * 用 0 當初值就分不出「讀到 alt 0」與「這筆傳輸沒發生」——
     * 我先前就靠這個誤判過一輪，而 MUTE 那次讀回 255 才露了餡。 */
    g_rb[0] = 0xAAU; g_rb[1] = 0xAAU; g_rb[2] = 0xAAU; g_rb[3] = 0xAAU;

    if (step == 0U)                       /* 標準請求：GET_INTERFACE */
    {
      hUsbHostFS.Control.setup.b.bmRequestType =
        (uint8_t)(USB_D2H | USB_REQ_RECIPIENT_INTERFACE | USB_REQ_TYPE_STANDARD);
      hUsbHostFS.Control.setup.b.bRequest  = USB_REQ_GET_INTERFACE;
      hUsbHostFS.Control.setup.b.wValue.w  = 0U;
      hUsbHostFS.Control.setup.b.wIndex.w  = h->headphone.interface;
      hUsbHostFS.Control.setup.b.wLength.w = 1U;
    }
    else if (step == 1U)                  /* 端點的取樣率 */
    {
      hUsbHostFS.Control.setup.b.bmRequestType =
        (uint8_t)(USB_D2H | USB_REQ_RECIPIENT_ENDPOINT | USB_REQ_TYPE_CLASS);
      hUsbHostFS.Control.setup.b.bRequest  = UAC_GET_CUR;
      hUsbHostFS.Control.setup.b.wValue.w  = (uint16_t)(SAMPLING_FREQ_CONTROL << 8);
      hUsbHostFS.Control.setup.b.wIndex.w  = h->headphone.Ep;
      hUsbHostFS.Control.setup.b.wLength.w = 3U;
    }
    else                                  /* Feature Unit 的音量 */
    {
      AUDIO_FeatureDescTypeDef *fu =
        h->class_desc.cs_desc.FeatureUnitDesc[h->headphone.asociated_feature];

      if (fu == NULL) { return USBH_FAIL; }
      hUsbHostFS.Control.setup.b.bmRequestType =
        (uint8_t)(USB_D2H | USB_REQ_RECIPIENT_INTERFACE | USB_REQ_TYPE_CLASS);
      hUsbHostFS.Control.setup.b.bRequest  = UAC_GET_CUR;
      /* **聲道 1**，不是聲道 0。主聲道沒有音量控制。 */
      hUsbHostFS.Control.setup.b.wValue.w  =
        (uint16_t)(((uint16_t)VOLUME_CONTROL << 8) | 1U);
      hUsbHostFS.Control.setup.b.wIndex.w  = (uint16_t)((uint16_t)fu->bUnitID << 8);
      hUsbHostFS.Control.setup.b.wLength.w = 2U;
    }
  }

  return USBH_CtlReq(&hUsbHostFS, g_rb,
                     (step == 0U) ? 1U : ((step == 1U) ? 3U : 2U));
}


/* --- 從原始描述元推導「耳機那條路的 Feature Unit」---------------------
 * ST 的類別用 headphone.asociated_feature 這個**索引**去查
 * class_desc.cs_desc.FeatureUnitDesc[]，而那個索引是它自己配的。
 * ROG Delta II 有兩個 Feature Unit（耳機 ID 2、麥克風 ID 6），
 * 對帳量到的結果是：**裝置的音量卡在 -74dB（= volumeMin，全靜音），
 * 而類別以為是 -32dB** —— 72 次寫入全部落空。
 *
 * 這裡改成走原始描述元：找 wTerminalType 是喇叭/耳機那一族的
 * OUTPUT_TERMINAL，它的 bSourceID 就是要控制的單元。
 * 跟挑 alt setting 同一個原則 —— **不要相信中介層的索引記帳，
 * 原始位元組才是唯一的事實來源。**
 *
 * 0x0301 喇叭 / 0x0302 耳機 / 0x0303 頭戴式 / 0x0304 桌上型喇叭 ...
 * 統一看高位元組是不是 0x03。 */
static uint8_t g_fu_id = 0xFFU;         /* 哨兵：沒找到 */

static void usb_find_headphone_feature(void)
{
  const uint8_t *raw = hUsbHostFS.device.CfgDesc_Raw;
  uint16_t have = hUsbHostFS.device.CfgDesc.wTotalLength;
  uint16_t i = 0U;

  g_fu_id = 0xFFU;

  while ((uint16_t)(i + 2U) <= have)
  {
    uint8_t blen = raw[i];

    if ((blen < 2U) || ((uint16_t)(i + blen) > have)) { break; }

    /* CS_INTERFACE(0x24) / OUTPUT_TERMINAL(0x03)：
     * [3]bTerminalID [4:5]wTerminalType [6]bAssocTerminal [7]bSourceID */
    if ((raw[i + 1U] == 0x24U) && (blen >= 9U) && (raw[i + 2U] == 0x03U) &&
        (raw[i + 5U] == 0x03U))
    {
      g_fu_id = raw[i + 7U];
      break;
    }

    i = (uint16_t)(i + blen);
  }
}

/* SET_CUR 音量到指定的 Feature Unit / 聲道。dB 值 x 256（UAC1 的單位）。 */
static uint8_t g_vbuf[2];

static USBH_StatusTypeDef audio_set_vol_direct(uint8_t unit, uint8_t chan,
                                               int16_t val)
{
  if (hUsbHostFS.RequestState == CMD_SEND)
  {
    g_vbuf[0] = (uint8_t)((uint16_t)val & 0xFFU);
    g_vbuf[1] = (uint8_t)(((uint16_t)val >> 8) & 0xFFU);

    hUsbHostFS.Control.setup.b.bmRequestType =
      (uint8_t)(USB_H2D | USB_REQ_RECIPIENT_INTERFACE | USB_REQ_TYPE_CLASS);
    hUsbHostFS.Control.setup.b.bRequest  = UAC_SET_CUR;
    hUsbHostFS.Control.setup.b.wValue.w  =
      (uint16_t)(((uint16_t)VOLUME_CONTROL << 8) | chan);
    hUsbHostFS.Control.setup.b.wIndex.w  = (uint16_t)((uint16_t)unit << 8);
    hUsbHostFS.Control.setup.b.wLength.w = 2U;
  }

  return USBH_CtlReq(&hUsbHostFS, g_vbuf, 2U);
}

/**
  * @brief  Starts Audio streaming.
  * @param  idx: File index
  * @retval Audio error
  */
AUDIO_ErrorTypeDef AUDIO_Start(uint8_t idx)
{
  uint32_t bytesread;

  /* --- 暫時的測試修改（不是這個範例原本的行為）---------------------
   * 直接從指定的檔名開始播，省得按好幾次 USER 鍵。 */
  {
    uint16_t k;

    for (k = 0; k < FileList.ptr; k++)
    {
      if (strstr((char *)FileList.file[k].name, "video3") != NULL)
      {
        idx     = (uint8_t)k;
        FilePos = (int16_t)k;
        break;
      }
    }
  }

  if (FileList.ptr > idx)
  {
    f_close(&WavFile);

    AUDIO_GetFileInfo(idx, &WavInfo);

    /* --- 暫時的診斷輸出：把「檔案是什麼」跟「跟裝置談的結果」印出來 ---
     * 雜音有兩種完全不同的來源（格式不符 vs 餵不上），這兩行就分得出來。 */
    USBH_UsrLog("WAV: %luHz %uch %ubit, data=%lu bytes",
                (unsigned long)WavInfo.SampleRate,
                (unsigned)WavInfo.NbrChannels,
                (unsigned)WavInfo.BitPerSample,
                (unsigned long)WavInfo.SubChunk2Size);

    /* Set Frequency
     *
     * **這個類別是非同步的**：SetFrequency 只是發起一筆控制傳輸，完成之前
     * 一律回 USBH_BUSY。原本的範例呼叫一次就不管、連回傳值都沒看 ——
     * 結果取樣率**從來沒有真的設定到裝置上**，dongle 用自己的預設速率播、
     * 我們餵 48kHz，於是週期性補/丟樣本，聽起來就是「啵啵啵」，
     * 而且振幅越大越明顯（那是波形不連續，不是底噪）。
     *
     * 這裡只發起，實際的重試放在 PLAY 狀態 —— 不能在這裡卡迴圈等，
     * 因為完成它需要主迴圈去跑 USBH_Process。
     *
     * 補一句上一輪沒查清楚的機制：SetFrequency 回 USBH_BUSY **不是**因為
     * 控制傳輸還沒完成，而是因為它要求 play_state == AUDIO_PLAYBACK_IDLE，
     * 而類別剛掛上時是 AUDIO_PLAYBACK_INIT。重試是對的，理由不一樣。 */
    force_alt    = 0U;
    mic_off      = 0U;
    pre_alt      = 0U;
    mute_step    = 0U;
    rb_step      = 0U;
    dvol_step    = 0U;
    freq_pending = 1U;
    play_pending = 0U;
    play_started = 0U;
    eof_seen     = 0U;

    dbg_runway_min = 0xFFFFFFFFU;
    dbg_over_cnt   = 0U;
    dbg_over_max   = 0U;
    dbg_gap_max    = 0U;
    dbg_gap_prev   = 0xFFFFFFFFU;
    dbg_read_cnt   = 0U;
    dbg_read_max   = 0U;
    dbg_it_cnt     = 0U;
    dbg_t0         = 0xFFFFFFFFU;
    dbg_g0         = 0U;
    dbg_n          = 0U;
    dbg_phase      = 0U;

    /* Fill whole buffer at first time */
    if (f_read(&WavFile,
               &BufferCtl.buff[0],
               AUDIO_BLOCK_SIZE * AUDIO_BLOCK_NBR, (void *)&bytesread) == FR_OK)
    {
      if (bytesread != 0)
      {
        return AUDIO_ERROR_NONE;
      }
    }

    BufferCtl.in_ptr = 0;
  }
  return AUDIO_ERROR_IO;
}


/* --- 在類別送出 SET_INTERFACE 之前把 alt setting 換掉 ------------------
 * **時機就是全部。** usbh_core.c 在 pActiveClass->Init() 成功之後把
 * gState 設成 HOST_CLASS_REQUEST 然後 break（usbh_core.c:685-690），
 * 所以主迴圈這一輪還會再呼叫我們一次 —— 那是 InterfaceInit 已經填好
 * headphone.*、而 ClassRequest 的 AUDIO_REQ_SET_OUT_INTERFACE 還沒發出
 * 之前的唯一視窗。在這裡改，類別自己就會去設對的 alt。
 *
 * **不要等類別跑起來才從外面改。** 那是跟類別搶 alt setting 與
 * phost->Control 的所有權：實測連續三輪對帳量到三個不同的 alt
 * （1、2、0 —— 而 0 是零頻寬，等於沒有端點），GET_CUR 甚至讀不到東西
 * （緩衝裡留著哨兵 255）。三個不同的答案就是在說「這個東西不歸你管」。 */
static void audio_fixup_alt_once(void)
{
  static uint8_t done = 0U;
  AUDIO_HandleTypeDef *h;

  if (hUsbHostFS.gState == HOST_IDLE) { done = 0U; }   /* 拔掉重插要重來 */
  if (done != 0U) { return; }
  if (hUsbHostFS.gState != HOST_CLASS_REQUEST) { return; }
  if (hUsbHostFS.pActiveClass == NULL) { return; }

  h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;
  if (h == NULL) { return; }

  done = 1U;
  usb_pick_matching_alt(48000U, 2U, 16U);

  if (g_alt_if == 0xFFU)
  {
    USBH_UsrLog("ALT: 找不到 2ch/16bit/48000 的 OUT 串流，沿用類別挑的 alt=%u",
                (unsigned)h->headphone.AltSettings);
  }
  else if (g_alt_num != h->headphone.AltSettings)
  {
    USBH_UsrLog("ALT: 趁 SET_INTERFACE 之前改掉 alt %u -> %u（mps %u -> %u）",
                (unsigned)h->headphone.AltSettings, (unsigned)g_alt_num,
                (unsigned)h->headphone.EpSize, (unsigned)g_alt_mps);
    h->headphone.AltSettings = g_alt_num;
    h->headphone.EpSize      = g_alt_mps;
  }
  else
  {
    USBH_UsrLog("ALT: 類別挑的 alt=%u 本來就相符", (unsigned)g_alt_num);
  }
}


/* --- 唯讀追蹤 ST 的類別請求狀態機 -------------------------------------
 * 症狀：ROG Delta II 最後停在 alt 0（零頻寬，等於沒有端點）。
 * ST 的 ClassRequest 順序是
 *   SET_DEFAULT_OUT_INTERFACE(alt 0) -> CS_REQUESTS(一串音量查詢)
 *   -> SET_OUT_INTERFACE(alt N)
 * 懷疑中間那串查詢被 STALL，導致最後一步沒走到。
 *
 * **不改中介層，只讀。** 主迴圈每毫秒跑 160 圈，狀態轉換一個都不會漏。
 * 記進陣列、結束後一次倒出來 —— 收集期間不印，免得自己變成干擾源
 * （board-notes 8.8 那個 7.4ms 的教訓）。
 *
 * req_state:  1=INIT 2=IDLE 3=SET_DEF_IN 4=SET_DEF_OUT 5=SET_IN
 *             6=SET_OUT 7=CS_REQUESTS
 * cs_req_state: 1=SET_VOL 2=SET_MUTE 3=GET_CURR_VOL 4=GET_MIN 5=GET_MAX
 *               6=GET_VOL 7=GET_RES 8=CS_IDLE
 */
#define AUDIO_TRACE_N  48U
static uint8_t  g_tr[AUDIO_TRACE_N][2];
static uint8_t  g_tr_n = 0U;
static uint8_t  g_tr_dumped = 0U;

static void audio_trace_class_request(void)
{
  AUDIO_HandleTypeDef *h;

  if (hUsbHostFS.gState == HOST_IDLE) { g_tr_n = 0U; g_tr_dumped = 0U; }

  if (hUsbHostFS.pActiveClass == NULL) { return; }
  h = (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;
  if (h == NULL) { return; }

  if (hUsbHostFS.gState == HOST_CLASS_REQUEST)
  {
    uint8_t r = (uint8_t)h->req_state;
    uint8_t c = (uint8_t)h->cs_req_state;

    if ((g_tr_n == 0U) ||
        (g_tr[g_tr_n - 1U][0] != r) || (g_tr[g_tr_n - 1U][1] != c))
    {
      if (g_tr_n < AUDIO_TRACE_N)
      {
        g_tr[g_tr_n][0] = r;
        g_tr[g_tr_n][1] = c;
        g_tr_n++;
      }
    }
  }
  else if ((g_tr_dumped == 0U) && (g_tr_n > 0U))
  {
    uint8_t k;
    char line[AUDIO_TRACE_N * 6 + 1];
    uint16_t n = 0U;

    g_tr_dumped = 1U;
    for (k = 0U; k < g_tr_n; k++)
    {
      n += (uint16_t)sprintf(&line[n], "%u.%u ", (unsigned)g_tr[k][0],
                             (unsigned)g_tr[k][1]);
    }
    line[n] = '\0';
    USBH_UsrLog("REQTRACE(%u): %s", (unsigned)g_tr_n, line);
    USBH_UsrLog("REQTRACE 對照 req:1INIT 2IDLE 3SETDEFIN 4SETDEFOUT "
                "5SETIN 6SETOUT 7CSREQ / cs:1SETVOL 2SETMUTE 3GETCUR "
                "4GETMIN 5GETMAX 6GETVOL 7GETRES 8IDLE");
  }
  else
  {
    /* 已經倒過了。 */
  }
}

/**
  * @brief  Manages Audio process.
  * @param  None
  * @retval Audio error
  */
AUDIO_ErrorTypeDef AUDIO_Process(void)
{
  uint8_t str[16];
  int32_t diff;
  uint32_t bytesread, elapsed_time;
  static uint32_t prev_elapsed_time = 0xFFFFFFFF;
  AUDIO_ErrorTypeDef error_state = AUDIO_ERROR_NONE;

  audio_fixup_alt_once();
  audio_trace_class_request();

  switch(AUDIO_app_state)
  {
  case AUDIO_STATE_PLAYBACK_IDLE:
    if (Appli_state == APPLICATION_READY)
    {
      /* --- 量測：印在這裡是因為此時類別剛掛上、描述元已經在手上，
       * 而且**還沒碰 SD 卡** —— 卡有問題也不會把這份量測一起帶走。 */
      {
        static uint8_t dumped = 0U;

        if (dumped == 0U)
        {
          AUDIO_HandleTypeDef *ah =
            (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

          dumped = 1U;
          USB_DumpCfgDesc();

          /* 我們永遠送 48000Hz / 2 聲道 / 16 bit（video2bin 就是這樣輸出的）*/
          usb_find_headphone_feature();
          USBH_UsrLog("FU: 描述元推導出耳機的 Feature Unit = %u；"
                      "類別用的索引是 %u",
                      (unsigned)g_fu_id,
                      (ah != NULL) ? (unsigned)ah->headphone.asociated_feature
                                   : 0xFFU);

          usb_pick_matching_alt(48000U, 2U, 16U);
          if (g_alt_if == 0xFFU)
          {
            USBH_UsrLog("ALT: 找不到 2ch/16bit/48000 的 OUT 串流 —— "
                        "沿用類別挑的 alt=%u",
                        (ah != NULL) ? (unsigned)ah->headphone.AltSettings : 0xFFU);
          }
          else
          {
            USBH_UsrLog("ALT: 相符的是 if=%u alt=%u mps=%u；類別挑的是 alt=%u",
                        (unsigned)g_alt_if, (unsigned)g_alt_num,
                        (unsigned)g_alt_mps,
                        (ah != NULL) ? (unsigned)ah->headphone.AltSettings : 0xFFU);
          }
        }
      }
      AUDIO_app_state = AUDIO_STATE_PLAYBACK_EXPLORE;
      AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_IDLE;
    }
    break;

  case AUDIO_STATE_PLAYBACK_EXPLORE:
    if (Appli_state == APPLICATION_READY)
    {
      /* Init SD Storage */
      if (SD_StorageInit() == 0)
      {
        USBH_UsrLog("SD Parsing .........");
        SD_StorageParse();
      }
      /* Show Wav Files */
      if (Audio_ShowWavFiles() == 0)
      {
        /* --- 暫時的測試修改：不等按鍵，自己開播 ---------------------
         * 遠端除錯時「等使用者按鍵」會讓每一輪都要人在旁邊配合，
         * 而且錄序列埠的時機很難抓（board-notes 16.7 記過同一件事：
         * 手動步驟沒有除錯價值，只會讓循環變慢）。 */
        AUDIO_app_state = AUDIO_STATE_PLAYBACK_CONFIG;
        AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_EXPLORE;
        USBH_UsrLog("Auto-start playback (test build)");
      }
      else
      {
        AUDIO_app_state = AUDIO_STATE_PLAYBACK_IDLE;
        USBH_ErrLog("\nPlease check your SD card\n");
      }
    }
    break;

  case AUDIO_STATE_PLAYBACK_WAIT:
    break;

  case AUDIO_STATE_PLAYBACK_CONFIG:
    if(Appli_state == APPLICATION_READY)
    {
      AUDIO_app_state = AUDIO_STATE_PLAYBACK_START;
      AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_CONFIG;
    }
    break;

  case AUDIO_STATE_PLAYBACK_START:
    /* Read and Write File Here */
    if(Appli_state == APPLICATION_READY)
    {
      USBH_UsrLog("*** Playing audio ***\n");
      if (AUDIO_Start(0) == AUDIO_ERROR_IO)
      {
        USBH_UsrLog("*** AUDIO_ERROR_IO 1 ***");
      }
      AUDIO_app_state = AUDIO_STATE_PLAYBACK_PLAY;
      AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_START;
    }
    break;

  case AUDIO_STATE_PLAYBACK_PLAY:
    /* --- 暫時的測試修改：開播之後自動把音量往上加 -------------------
     * ST 的類別只提供一格一格的 VOLUME_UP（相對值，沒有絕對音量），
     * 而且每次是一筆非同步的控制傳輸 —— 連續呼叫會互相蓋掉。
     * 所以隔一段時間才加一格，加到設定的次數為止。
     * **刻意從小聲慢慢往上**，使用者戴著耳機。 */
    if (force_alt == 0U)
    {
      /* --- 即使類別已經挑對了，還是再送一筆 SET_INTERFACE ---------------
       * 實測：類別在 ClassRequest 裡的那筆（AUDIO_REQ_SET_OUT_INTERFACE）
       * 狀態機顯示回報 OK，**但裝置事後回報自己在 alt 0**（零頻寬）。
       * 而應用層自己補送一筆，裝置就確實在 alt 1。
       * 為什麼類別那筆沒生效還沒查出來 —— 但這兩件事是獨立的，
       * 管線要用中介層挑對（不然 mps 是 576 而端點是 384），
       * alt 要靠這一筆確實推過去。 */
      if ((g_alt_if == 0xFFU) ||
          (USBH_SetInterface(&hUsbHostFS, g_alt_if, g_alt_num) == USBH_OK))
      {
        force_alt = 1U;
        USBH_UsrLog("ALT 補送 SET_INTERFACE(if=%u, alt=%u)",
                    (unsigned)g_alt_if, (unsigned)g_alt_num);
      }
    }
    else if (mic_off == 0U)
    {
      /* --- 把麥克風介面放回 alt 0 -------------------------------------
       * 類別的 AUDIO_REQ_SET_IN_INTERFACE 會把麥克風設到它的 alt N，
       * 宣告一條等時 IN 頻寬 —— 然後從來不去讀它。只想播放的主機
       * （例如電腦只開喇叭時）不會這樣做，它會把麥克風留在零頻寬。
       * 這是「電腦會做而我們沒做」的差異裡最便宜的一個。 */
      AUDIO_HandleTypeDef *mh =
        (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

      if ((mh == NULL) || (mh->microphone.supported != 1U) ||
          (USBH_SetInterface(&hUsbHostFS, mh->microphone.interface, 0U)
           == USBH_OK))
      {
        mic_off = 1U;
        USBH_UsrLog("MIC 介面放回 alt 0");
      }
    }
    else if (pre_alt == 0U)
    {
      USBH_StatusTypeDef pst = audio_readback(0U);

      if (pst == USBH_OK)
      {
        pre_alt = 1U;
        USBH_UsrLog("對帳(開播前) 裝置在 alt=%u%s", (unsigned)g_rb[0],
                    (g_rb[0] == 0xAAU) ? "  <- 哨兵！這筆傳輸沒發生" : "");
      }
      else if (pst != USBH_BUSY)
      {
        pre_alt = 1U;
        USBH_UsrLog("對帳(開播前) 回 %d", (int)pst);
      }
      else
      {
        /* 還在傳。 */
      }
    }
    else if (mute_step < 3U)
    {
      /* 讀 -> 寫 0 -> 再讀。在 SetFrequency 之前做完，之後就不再碰它。 */
      USBH_StatusTypeDef mst = audio_mute_req((mute_step == 1U) ? 1U : 0U, 0U);

      if (mst == USBH_OK)
      {
        if (mute_step == 0U)
        {
          USBH_UsrLog("MUTE 原本是 %u（1=靜音）", (unsigned)g_mute_val);
        }
        else if (mute_step == 2U)
        {
          USBH_UsrLog("MUTE 解除後讀回 %u", (unsigned)g_mute_val);
        }
        else
        {
          /* 寫入那一步不印，下一步會讀回來對。 */
        }
        mute_step++;
      }
      else if (mst != USBH_BUSY)
      {
        USBH_UsrLog("MUTE 第 %u 步回 %d —— 裝置不支援主聲道靜音控制，跳過",
                    (unsigned)mute_step, (int)mst);
        mute_step = 3U;
      }
      else
      {
        /* 還在傳，下一輪再來。 */
      }
    }
    else if (dvol_step < 2U)
    {
      USBH_StatusTypeDef dst;

      if (g_fu_id == 0xFFU)
      {
        USBH_UsrLog("VOLd 找不到耳機那條路的 Feature Unit，跳過");
        dvol_step = 2U;
      }
      else
      {
        dst = audio_set_vol_direct(g_fu_id, (uint8_t)(dvol_step + 1U),
                                   (int16_t)(AUDIO_VOL_DB * 256));
        if (dst == USBH_OK)
        {
          USBH_UsrLog("VOLd 單元 %u 聲道 %u <- %ddB",
                      (unsigned)g_fu_id, (unsigned)(dvol_step + 1U),
                      (int)AUDIO_VOL_DB);
          dvol_step++;
        }
        else if (dst != USBH_BUSY)
        {
          USBH_UsrLog("VOLd 單元 %u 聲道 %u 回 %d，跳過",
                      (unsigned)g_fu_id, (unsigned)(dvol_step + 1U), (int)dst);
          dvol_step = 2U;
        }
        else
        {
          /* 還在傳。 */
        }
      }
    }
    else if (freq_pending != 0U)
    {
      USBH_StatusTypeDef st = USBH_AUDIO_SetFrequency(&hUsbHostFS,
                                WavInfo.SampleRate,
                                WavInfo.NbrChannels, WavInfo.BitPerSample);
      if (st == USBH_OK)
      {
        freq_pending = 0U;
        play_pending = 1U;
        USBH_UsrLog("SetFrequency OK: %luHz %uch %ubit",
                    (unsigned long)WavInfo.SampleRate,
                    (unsigned)WavInfo.NbrChannels,
                    (unsigned)WavInfo.BitPerSample);
      }
    }
    else if (play_pending != 0U)
    {
      /* --- 開播：自己重試，不要等回呼 --------------------------------
       * 唯一會讓類別開始送資料的是 USBH_AUDIO_Play()，而它要求
       * play_state == AUDIO_PLAYBACK_IDLE。SetFrequency 回 OK 只是把類別
       * 推進 AUDIO_PLAYBACK_SET_EP，那筆控制傳輸完成之後才回到 IDLE。
       *
       * **原本的程式不是這樣開播的**：它靠類別在 SET_EP 完成的那一刻
       * 呼叫 USBH_AUDIO_FrequencySet() 回呼，而我們的回呼只在
       * AUDIO_app_state == PLAYBACK_CONFIG 時才動作 —— 狀態機下一輪就
       * 離開 CONFIG 了，所以那是一場競爭：撞不上就整輪白跑，
       * GetOutOffset 回 -1 被當成檔案結束，繞 NEXT 的圈子重來。
       *
       * 這裡改成主動重試到 OK。play_state 回到 IDLE 之後就不會再變，
       * 所以不必剛好在那一瞬間呼叫，也就沒有競爭可言。 */
      if (USBH_AUDIO_Play(&hUsbHostFS, &BufferCtl.buff[0],
                          WavInfo.FileSize) == USBH_OK)
      {
        play_pending = 0U;
        play_started = 1U;
        USBH_UsrLog("Play started");
      }
    }

    /* 音量：走到絕對目標為止。等真的開播之後再開始 —— USBH_AUDIO_SetVolume
     * 要求 play_state == AUDIO_PLAYBACK_PLAY，而且它跟開播共用同一條
     * 控制傳輸的狀態機，早插進去只是多一個東西在競爭。 */
    if ((play_started != 0U) && (AUDIO_USE_CLASS_VOL != 0))
    {
      static uint32_t vol_tick  = 0;
      static uint8_t  vol_steps = 0;
      static uint8_t  vol_done  = 0;
      static int32_t  vol_tgt   = 0;
      static uint8_t  vol_announced = 0;
      static uint32_t vol_t0    = 0;    /* 這一輪爬升的起點時刻 */
      static int32_t  vol_from  = 0;    /* 起點音量，用來看它到底有沒有動 */

      AUDIO_HandleTypeDef *vh =
        (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

      if (rb_step < 3U)
      {
        USBH_StatusTypeDef rst = audio_readback(rb_step);

        if (rst == USBH_OK)
        {
          if (rb_step == 0U)
          {
            USBH_UsrLog("對帳 裝置實際在 alt=%u（我們以為 %u）",
                        (unsigned)g_rb[0], (unsigned)vh->headphone.AltSettings);
          }
          else if (rb_step == 1U)
          {
            USBH_UsrLog("對帳 端點取樣率 = %lu Hz",
                        (unsigned long)((uint32_t)g_rb[0] |
                                        ((uint32_t)g_rb[1] << 8) |
                                        ((uint32_t)g_rb[2] << 16)));
          }
          else
          {
            USBH_UsrLog("對帳 聲道1 音量 = %lddB（類別以為 %lddB）",
                        (long)(((int16_t)((uint16_t)g_rb[0] |
                                          ((uint16_t)g_rb[1] << 8))) / 256),
                        (long)(((int16_t)vh->headphone.attribute.volume) / 256));
          }
          rb_step++;
        }
        else if (rst != USBH_BUSY)
        {
          USBH_UsrLog("對帳 第 %u 步回 %d（裝置不支援這個查詢）",
                      (unsigned)rb_step, (int)rst);
          rb_step++;
        }
        else
        {
          /* 還在傳。 */
        }
      }

      if (g_vol_dirty != 0U)
      {
        g_vol_dirty   = 0U;
        vol_done      = 0U;
        vol_steps     = 0U;
        vol_announced = 0U;
      }

      if ((vol_done == 0U) && (vh != NULL))
      {
        int32_t lo  = (int16_t)vh->headphone.attribute.volumeMin;
        int32_t hi  = (int16_t)vh->headphone.attribute.volumeMax;
        int32_t cur = (int16_t)vh->headphone.attribute.volume;
        int32_t res = (int32_t)(int16_t)vh->headphone.attribute.resolution;

        if (res <= 0) { res = 1; }

        if (vol_announced == 0U)
        {
          vol_announced = 1U;
          vol_tgt  = lo + (((hi - lo) * (int32_t)g_vol_pct) / 100);
          vol_t0   = HAL_GetTick();
          vol_from = cur;
          /* 一次把裝置的刻度攤開：raw 是 ST 存的原值，dB 是轉成有號之後
           * 除以 256。兩個都印，因為 ST 的 uint32_t 存法本身就可疑。 */
          USBH_UsrLog("VOL scale: min=%04lX(%ld.%02udB) max=%04lX(%ld.%02udB) "
                      "cur=%04lX(%lddB) res=%ld -> target %d%% = %ld (%lddB)",
                      (unsigned long)(vh->headphone.attribute.volumeMin & 0xFFFFU),
                      (long)(lo / 256), (unsigned)(((lo % 256) < 0 ? -(lo % 256) : (lo % 256)) * 100 / 256),
                      (unsigned long)(vh->headphone.attribute.volumeMax & 0xFFFFU),
                      (long)(hi / 256), (unsigned)(((hi % 256) < 0 ? -(hi % 256) : (hi % 256)) * 100 / 256),
                      (unsigned long)(vh->headphone.attribute.volume & 0xFFFFU),
                      (long)(cur / 256),
                      (long)res,
                      (unsigned)g_vol_pct,
                      (long)vol_tgt, (long)(vol_tgt / 256));
        }

        /* 120ms 一步。縮到 20ms 試過：加上 control_state 守門之後等於用
         * 控制傳輸猛敲 dongle，實測開機後斷線 4 次、音量走不完。
         * **一次只改一件事** —— 那一輪同時改了守門和節奏，分不出是誰的錯，
         * 退回已知可用的 120ms 之後才確定守門本身是對的。 */
        if ((HAL_GetTick() - vol_tick) > 120U)
        {
          vol_tick = HAL_GetTick();

          /* --- 配速：等上一步整個做完再發下一步 ---------------------
           * **一步音量不是一筆傳輸，是兩筆**：USBH_AUDIO_SetControlAttribute
           * 先設 channel 2，下一輪才設 channel 1（temp_channels 遞減）。
           * 中途再發一次 SetVolume 會把 control_state 蓋掉，
           * **兩個聲道就走散了** —— 聽起來就是左右換來換去、忽大忽小，
           * 而且只在音量移動的時候出現。
           *
           * 所以只在 control_state 回到 INIT/CHANGE（＝不在做音量）時才發。
           * 之前試過盯 attribute.volume 有沒有變，那是錯的尺：
           * 值變了不代表「兩個聲道都設完了」。 */
          if ((HAL_GetTick() - vol_t0) > AUDIO_VOL_BUDGET_MS)
          {
            vol_done = 1U;
            USBH_UsrLog("VOL 時間到：%lddB -> %lddB（目標 %lddB，發了 %u 次）",
                        (long)(vol_from / 256), (long)(cur / 256),
                        (long)(vol_tgt / 256), (unsigned)vol_steps);
          }
          else if ((cur >= (vol_tgt - (res / 2))) && (cur <= (vol_tgt + (res / 2))))
          {
            vol_done = 1U;
            USBH_UsrLog("VOL 到位：%u%% = %lddB（發了 %u 次）"
                        "；按 USER 鍵再降 %u%%",
                        (unsigned)g_vol_pct, (long)(cur / 256),
                        (unsigned)vol_steps, (unsigned)AUDIO_VOL_STEP_PCT);
          }
          else if ((vh->control_state == AUDIO_CONTROL_INIT) ||
                   (vh->control_state == AUDIO_CONTROL_CHANGE))
          {
            if (USBH_AUDIO_SetVolume(&hUsbHostFS,
                                     (cur < vol_tgt) ? VOLUME_UP : VOLUME_DOWN)
                == USBH_OK)
            {
              vol_steps++;
            }
          }
          else
          {
            /* 上一步還在做，等它。 */
          }
        }
      }
    }

    /* --- 這裡原本是 `if (GetOutOffset() < 0) 就當成檔案結束` ------------
     * 而 -1 有兩個意思：類別不在 PLAY 狀態就會回 -1，「還沒開播」與
     * 「播完了」長得一模一樣。現在三種情況各走各的路。 */
    if (play_started == 0U)
    {
      /* 還沒開播。什麼都不要做，尤其不要當成檔案結束。 */
    }
    else if (eof_seen != 0U)                       /* 真的播完了 */
    {
      AUDIO_app_state = AUDIO_STATE_PLAYBACK_NEXT;
    }
    else if ((BufferCtl.out_ptr = USBH_AUDIO_GetOutOffset(&hUsbHostFS)) < 0)
    {
      /* 開播過、類別卻已經不在 PLAY，而且沒有回報送完 —— 非預期。
       * 這一條以前是靜悄悄地被當成「檔案結束」吃掉的，現在讓它出聲。 */
      dbg_unexpected++;
      USBH_ErrLog("非預期停止 #%lu（開播過但類別離開 PLAY，且沒有 BufferEmpty）",
                  (unsigned long)dbg_unexpected);
      AUDIO_app_state = AUDIO_STATE_PLAYBACK_NEXT;
    }
    else
    {
      /* --- 量測（不改任何行為，只是數） --------------------------- */
      {
        uint32_t now = HAL_GetTick();
        uint32_t op  = (uint32_t)BufferCtl.out_ptr;
        int32_t  d;

        if (dbg_gap_prev != 0xFFFFFFFFU)
        {
          uint32_t gap = now - dbg_gap_prev;
          if (gap > dbg_gap_max) { dbg_gap_max = gap; }
        }
        dbg_gap_prev = now;
        dbg_it_cnt++;

        /* (B) 類別已經走過緩衝結尾了嗎 —— 是非題，不必量時間 */
        if (op > (uint32_t)AUDIO_BUF_TOTAL)
        {
          uint32_t over = op - (uint32_t)AUDIO_BUF_TOTAL;
          dbg_over_cnt++;
          if (over > dbg_over_max) { dbg_over_max = over; }
        }

        /* (A) 可播存量：已經寫好、還沒被送出去的位元組 */
        d = BufferCtl.out_ptr - (int32_t)BufferCtl.in_ptr;
        if (d < 0) { d += AUDIO_BUF_TOTAL; }
        if ((uint32_t)(AUDIO_BUF_TOTAL - d) < dbg_runway_min)
        {
          dbg_runway_min = (uint32_t)(AUDIO_BUF_TOTAL - d);
        }
      }

      if (BufferCtl.out_ptr >= AUDIO_BUF_TOTAL)          /* End of buffer */
      {
        USBH_AUDIO_ChangeOutBuffer(&hUsbHostFS, &BufferCtl.buff[0]);
      }
      else
      {
        diff = BufferCtl.out_ptr - BufferCtl.in_ptr;

        if (diff < 0)
        {
          diff = AUDIO_BUF_TOTAL + diff;
        }

        if (diff >= (AUDIO_BUF_TOTAL / 2))
        {
          uint32_t t0;

          BufferCtl.in_ptr += AUDIO_BLOCK_SIZE;

          if (BufferCtl.in_ptr >= AUDIO_BUF_TOTAL)
          {
            BufferCtl.in_ptr = 0;
          }

          t0 = HAL_GetTick();
          if (f_read(&WavFile,
                     &BufferCtl.buff[BufferCtl.in_ptr],
                     AUDIO_BLOCK_SIZE, (void *)&bytesread) != FR_OK)
          {
            f_close(&WavFile);
            error_state = AUDIO_ERROR_NONE;
          }
          {
            uint32_t dt = HAL_GetTick() - t0;
            dbg_read_cnt++;
            if (dt > dbg_read_max) { dbg_read_max = dt; }
          }
        }
      }
    }
    /* 爬升關掉時上面那個區塊整個不跑，對帳改在這裡做（開播後就開始）。 */
    if ((play_started != 0U) && (AUDIO_USE_CLASS_VOL == 0) && (rb_step < 3U))
    {
      static uint32_t rb_tick = 0;
      AUDIO_HandleTypeDef *vh2 =
        (AUDIO_HandleTypeDef *)hUsbHostFS.pActiveClass->pData;

      if (rb_tick == 0U) { rb_tick = HAL_GetTick(); }

      if (((HAL_GetTick() - rb_tick) > 3000U) && (vh2 != NULL))
      {
        USBH_StatusTypeDef rst = audio_readback(rb_step);

        if (rst == USBH_OK)
        {
          if (rb_step == 0U)
          {
            USBH_UsrLog("對帳(開播後) 裝置在 alt=%u（我們以為 %u）%s",
                        (unsigned)g_rb[0], (unsigned)vh2->headphone.AltSettings,
                        (g_rb[0] == 0xAAU) ? "  <- 哨兵！沒發生" : "");
          }
          else if (rb_step == 1U)
          {
            USBH_UsrLog("對帳 端點取樣率 = %lu Hz",
                        (unsigned long)((uint32_t)g_rb[0] |
                                        ((uint32_t)g_rb[1] << 8) |
                                        ((uint32_t)g_rb[2] << 16)));
          }
          else
          {
            USBH_UsrLog("對帳 聲道1 音量 = %lddB",
                        (long)(((int16_t)((uint16_t)g_rb[0] |
                                          ((uint16_t)g_rb[1] << 8))) / 256));
          }
          rb_step++;
        }
        else if (rst != USBH_BUSY)
        {
          USBH_UsrLog("對帳 第 %u 步回 %d", (unsigned)rb_step, (int)rst);
          rb_step++;
        }
        else
        {
          /* 還在傳。 */
        }
      }
    }

    /* --- 收集：一秒一格，收集期間一個字都不印 ------------------------ */
    if ((play_started != 0U) && (dbg_phase == 0U))
    {
      uint32_t now = HAL_GetTick();

      if (dbg_t0 == 0xFFFFFFFFU)
      {
        dbg_t0 = now;
        dbg_g0 = audio_global_ptr();
        dbg_s0 = hUsbHostFS.Timer;
      }
      else if ((now - dbg_t0) >= 1000U)
      {
        uint32_t g = audio_global_ptr();

        dbg_pk[dbg_n] = (g - dbg_g0) / 192U;
        dbg_ms[dbg_n] = now - dbg_t0;
        dbg_gp[dbg_n] = dbg_gap_max;
        dbg_rw[dbg_n] = dbg_runway_min;
        dbg_it[dbg_n] = dbg_it_cnt;
        dbg_sf[dbg_n] = hUsbHostFS.Timer - dbg_s0;
        dbg_s0 = hUsbHostFS.Timer;
        dbg_rd[dbg_n] = dbg_read_cnt;
        dbg_n++;

        dbg_t0 = now;
        dbg_g0 = g;
        dbg_gap_max    = 0U;
        dbg_runway_min = 0xFFFFFFFFU;
        dbg_it_cnt     = 0U;
        dbg_read_cnt   = 0U;

        if (dbg_n >= DBG_SAMPLES)
        {
          dbg_phase = 1U;
        }
      }
    }
    else if (dbg_phase == 1U)
    {
      uint16_t k;
      uint32_t miss_total = 0U;
      uint32_t sof_total  = 0U;
      uint32_t ms_total   = 0U;

      dbg_phase = 2U;
      USBH_UsrLog("=== FRAMES BEGIN（一格一秒；pk=送出封包數 ms=實際毫秒 "
                  "miss=pk-ms 的缺口）===");
      for (k = 0U; k < dbg_n; k++)
      {
        int32_t miss = (int32_t)dbg_ms[k] - (int32_t)dbg_pk[k];

        if (miss > 0) { miss_total += (uint32_t)miss; }
        sof_total += dbg_sf[k];
        ms_total  += dbg_ms[k];
        USBH_UsrLog("%02u pk=%lu sof=%lu ms=%lu miss=%ld it=%lu rd=%lu gap=%lu rw=%lu",
                    (unsigned)k,
                    (unsigned long)dbg_pk[k],
                    (unsigned long)dbg_sf[k], (unsigned long)dbg_ms[k],
                    (long)miss,
                    (unsigned long)dbg_it[k],
                    (unsigned long)dbg_rd[k],
                    (unsigned long)dbg_gp[k],
                    (unsigned long)dbg_rw[k]);
      }
      /* SOF 總數 vs 毫秒總數 = 時脈誤差。45000 個計數，1 個計數 = 0.002%，
       * 這把尺比要量的東西細三個數量級。ppm = (sof-ms)/ms * 1e6，
       * 用整數算避免浮點。 */
      USBH_UsrLog("=== FRAMES END 缺 %lu 訊框 / %u 秒，over=%lu；"
                  "SOF %lu / %lu ms，誤差 %ld ppm ===",
                  (unsigned long)miss_total, (unsigned)dbg_n,
                  (unsigned long)dbg_over_cnt,
                  (unsigned long)sof_total, (unsigned long)ms_total,
                  (ms_total != 0U)
                    ? (long)((((int32_t)sof_total - (int32_t)ms_total) * 1000000LL)
                             / (int32_t)ms_total)
                    : 0L);
    }
    else if (dbg_phase == 2U)
    {
      /* Display elapsed time */
      elapsed_time = WavFile.fptr / WavInfo.ByteRate;
      if(prev_elapsed_time != elapsed_time)
      {
        prev_elapsed_time = elapsed_time;
        sprintf((char *)str, "[%02lu:%02lu]", (unsigned long)(elapsed_time /60), (unsigned long)(elapsed_time%60));
        USBH_UsrLog("%s",str);
      }
    }
    else
    {
      /* 收集中：不印。 */
    }
    AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_PLAY;
    break;

  case AUDIO_STATE_PLAYBACK_NEXT:
    USBH_UsrLog("[NEXT]");
    if (++FilePos >= FileList.ptr)
    {
      FilePos = 0;
    }
    USBH_AUDIO_Stop(&hUsbHostFS);
    AUDIO_Start(FilePos);
    AUDIO_app_state = AUDIO_STATE_PLAYBACK_CONFIG;
    break;

  default:
    break;
  }
  if(Appli_state == APPLICATION_DISCONNECT)
  {
    Appli_state = APPLICATION_IDLE;
    USBH_ErrLog("USB device disconnected !!! \n");
    AUDIO_Stop();
    AUDIO_app_prev_state = AUDIO_STATE_PLAYBACK_IDLE;
  }
  return error_state;
}

/**
  * @brief  Stops Audio streaming.
  * @param  None
  * @retval Audio error
  */
AUDIO_ErrorTypeDef AUDIO_Stop(void)
{
  AUDIO_app_state = AUDIO_STATE_PLAYBACK_IDLE;
  USBH_AUDIO_Stop(&hUsbHostFS);
  FilePos = 0;
  f_close(&WavFile);
  return AUDIO_ERROR_NONE;
}

/**
  * @brief  Gets the file info.
  * @param  file_idx: File index
  * @param  info: Pointer to WAV file info
  * @retval Audio error
  */
static AUDIO_ErrorTypeDef AUDIO_GetFileInfo(uint16_t file_idx,
                                            WAV_InfoTypedef * info)
{
  uint32_t bytesread;

  if (f_open
      (&WavFile, (char *)FileList.file[file_idx].name,
       FA_OPEN_EXISTING | FA_READ) == FR_OK)
  {
    /* Fill the buffer to Send */
    if (f_read(&WavFile, info, sizeof(WAV_InfoTypedef), (void *)&bytesread) ==
        FR_OK)
    {
      /* --- 暫時的診斷修正（不是這個範例原本的行為）---------------------
       * 這個結構假設 data 區塊固定在第 44 個位元組，但 ffmpeg 產生的 wav
       * 會在 fmt 與 data 之間插一個 LIST 區塊。照 44 去讀的話會把 LIST
       * 當成音訊，而且整個檔案錯開 —— 偏移 34 不是 4 的倍數，16-bit 立體聲
       * 的每個取樣都被切成兩半，症狀就是「聽得出原本的聲音但疊著雜訊」。
       * 這裡改成走區塊鏈找到真正的 data，用來驗證雜訊就是這個原因。 */
      if (info->SubChunk2ID != 0x61746164U)      /* 'data' */
      {
        uint8_t  ck[8];
        uint32_t len, guard;

        (void)f_lseek(&WavFile, 12U + 8U + info->SubChunk1Size);
        for (guard = 0; guard < 16U; guard++)
        {
          if (f_read(&WavFile, ck, 8U, (void *)&bytesread) != FR_OK ||
              bytesread != 8U) { break; }
          len = (uint32_t)ck[4] | ((uint32_t)ck[5] << 8) |
                ((uint32_t)ck[6] << 16) | ((uint32_t)ck[7] << 24);
          if (ck[0] == 'd' && ck[1] == 'a' && ck[2] == 't' && ck[3] == 'a')
          {
            info->SubChunk2Size = len;           /* 檔案指標已經停在資料開頭 */
            USBH_UsrLog("WAV: data chunk found at %lu (not 44)",
                        (unsigned long)f_tell(&WavFile));
            break;
          }
          (void)f_lseek(&WavFile, f_tell(&WavFile) + len + (len & 1U));
        }
      }

      if( oldfile != FileList.file[file_idx].name)
      {
        USBH_UsrLog("Playing file : ");
        USBH_UsrLog("%s",FileList.file[file_idx].name);
        oldfile = FileList.file[file_idx].name;
        USBH_UsrLog("Press the USER BUTTON to play the next wav file.");
      }
      return AUDIO_ERROR_NONE;
    }
    f_close(&WavFile);
  }
  return AUDIO_ERROR_IO;
}

/**
  * @brief  Informs user that settings have been changed.
  * @param  phost: Host Handle
  * @retval None
  */
void USBH_AUDIO_FrequencySet(USBH_HandleTypeDef * phost)
{
  UNUSED(phost);

  /* --- 這裡原本是整個範例唯一的開播點 -------------------------------
   *     if (AUDIO_app_state == AUDIO_STATE_PLAYBACK_CONFIG) {
   *       USBH_AUDIO_Play(...); AUDIO_app_state = ...PLAY;
   *     }
   * 類別在 SET_EP 完成的那一刻呼叫這個回呼，而應用層的狀態機下一輪就
   * 離開 CONFIG —— 撞得上才開得成播。開播的責任已經移到 PLAY 狀態裡
   * 主動重試，這裡只留下記錄，用來確認回呼確實有進來過。 */
  USBH_UsrLog("FrequencySet callback (app_state=%d)", (int)AUDIO_app_state);
}

/**
  * @brief  類別回報「這一段資料全部送完了」。
  *
  *         這是**唯一可信的「檔案播完了」**：USBH_AUDIO_OutputStream 在
  *         global_ptr 超過 total_length 時才呼叫它。拿 GetOutOffset() 的
  *         -1 當結束會把「還沒開播」一起吃進來。
  * @param  phost: Host Handle
  * @retval None
  */
void USBH_AUDIO_BufferEmptyCallback(USBH_HandleTypeDef * phost)
{
  UNUSED(phost);
  eof_seen = 1U;
}

/**
  * @brief  GPIO EXTI Callback function
  *         Handle remote-wakeup through key button
  * @param  GPIO_Pin
  * @retval None
  */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
  if (GPIO_Pin == USER_BUTTON_Pin)
  {
    /* --- 這顆鍵原本是「跳下一首」，改成音量 -------------------------
     * 治具只播一個檔案（AUDIO_Start 用檔名挑 video3），跳下一首沒有用處；
     * 而音量只能靠耳朵找，改一個數字重燒一次太慢。
     * 按一下降 AUDIO_VOL_STEP_PCT 個百分點，降到底繞回起始值。
     * 到位的 dB 會印到 COM4，找到滿意的位置就把百分比寫回
     * AUDIO_VOL_PERCENT。 */
    if (g_vol_pct > (AUDIO_VOL_FLOOR_PCT + AUDIO_VOL_STEP_PCT))
    {
      g_vol_pct = (uint8_t)(g_vol_pct - AUDIO_VOL_STEP_PCT);
    }
    else
    {
      g_vol_pct = AUDIO_VOL_PERCENT;
    }
    g_vol_dirty = 1U;
  }
}