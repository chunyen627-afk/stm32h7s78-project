# ST 官方韌體包與 BSP：體積龐大且有自己的倉庫，用 scripts/setup.sh 取得
cube/
bsp/

# CubeIDE headless build 的工作區
ws/

# 建置產物
*.o
*.d
*.su
*.cyclo
*.elf
*.map
*.list
Debug/
Release/

# firmware/ 底下是刻意提交的預編譯燒錄檔，不要排除
*.bin
*.hex
!firmware/**/*.bin
!firmware/**/*.hex

# 測試中間檔
projects/video/.cache/
test/*.elf
shots/*.raw

# album 的字型表由 tools/genfont.py 產生（6.4MB），不進版控。
# scripts/setup.sh 會在缺少時自動產生。
projects/album/core/font_zh.c
projects/album/core/font_zh.h
# 賽車儀表的字型：建置時由 tools/ 產生。數字字型是 Windows 內建 Bahnschrift
# 渲染出來的，1.3MB 而且不在公開倉庫散布
projects/racedash/core/font_zh.*
projects/racedash/core/numfont.*
projects/racedash/test/*.exe

# 韌體包位置（舊版 album 用過，已不需要）
.cube_path

# PC 端測試台的產物（執行檔、原始影像、framebuffer、PNG）
projects/*/test/out/

# 測試用的第三方照片，不進版控
projects/*/test/photos/
projects/racedash/gt7dash/build/

# RaceDash Bridge：exe 留著（換電腦直接裝），紀錄檔不要
projects/racedash/bridge/build/*.log
projects/racedash/bridge/build/*.txt
projects/racedash/bridge/build/*.ini
